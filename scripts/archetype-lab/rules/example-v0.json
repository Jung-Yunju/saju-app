      "terms": [
        { "id": "wood-share", "label": "목 기운 비율", "linear": { "f": "el.share.wood", "mul": 8, "offset": 0.2, "min": 0, "max": 3 } },
        { "id": "spring", "label": "봄 월령", "when": { "f": "season", "eq": "spring" }, "points": 1 },
        { "id": "grow-flow", "label": "목 일간이 식상으로 흐름", "when": { "all": [ { "f": "dm.element", "eq": "wood" }, { "f": "fl.toOutput", "eq": true } ] }, "points": 1.5 },
        { "id": "long-chain", "label": "상생 연쇄 3 이상", "when": { "f": "fl.chainLength", "gte": 3 }, "points": 0.5 }
      ]
    },
