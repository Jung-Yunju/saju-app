generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  kakaoId       String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  readings  Reading[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  orderId       String      @unique  // 토스페이먼츠 주문ID
  amount        Int         // 19900
  status        OrderStatus @default(PENDING)
  paymentKey    String?     // 토스페이먼츠 paymentKey
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading Reading?
}

model Reading {
  id        String      @id @default(cuid())
  userId    String
  orderId   String      @unique
  readingType ReadingType @default(BASIC)
  // 본인 사주
  name      String?
  birthYear Int
  birthMonth Int
  birthDay  Int
  birthHour Int?
  gender    String
  calType   String      @default("SOLAR")
  // 상대방 사주 (2인 풀이용)
  otherName       String?
  otherBirthYear  Int?
  otherBirthMonth Int?
  otherBirthDay   Int?
  otherBirthHour  Int?
  otherGender     String?
  // 2단계 풀이 필드
  status      String   @default("COMPLETE")  // VERIFYING | COMPLETE
  sajuInput   Json?    // Claude에 전달하는 사주 JSON
  claims      Json?    // 1차 호출 결과 (과거 검증 6가지)
  userAnswers Json?    // 사용자 맞다/아니다 답변
  fullReading Json?    // 2차 호출 결과 (본 풀이 JSON)
  // 구버전 호환 (마크다운 풀이)
  content   String      @default("") @db.Text
  createdAt DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum ReadingType {
  BASIC     // 나는 어떤 사람인가
  MONEY     // 나는 왜 돈이 안 모일까
  LOVE      // 나는 왜 연애가 안 될까
  CAREER    // 나는 왜 직장이 안 맞을까
  BULLY     // 이 사람은 왜 나를 괴롭힐까
  CONFLICT  // 우리는 왜 맨날 싸울까
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}
