# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# 가상 사무실 수집 기록 (커밋 금지)
/.claude/office/

# 견본 풀이 출력(대표 확인 전 비공개)
/samples/

# 견본 풀이 블라인드 채점 정답표·점수(커밋 금지)
samples/**/blind-key.json
samples/**/blind-scores*
